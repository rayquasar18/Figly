# Figly Environment Variables

# Database
DATABASE_URL=postgresql://figly:figly_dev@localhost:5432/figly

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=figly-media

# JWT Secrets
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Resend (email service)
RESEND_API_KEY=re_dev_placeholder

# Server
PORT=4000
